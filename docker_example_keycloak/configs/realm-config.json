{
    "realm": "backend",
    "enabled": true,
    "requiredCredentials": [
        "password"
    ],
    "users": [
        {   
            "username": "springboot",
            "enabled": true,
            "email": "springboot@example.com",
            "firstName": "Spring",
            "lastName": "Boot",
            "credentials": [
                {
                    "type": "password",
                    "value": "admin",
                    "temporary": false
                }
            ],
            "realmRoles": ["admin", "user"],
            "requiredActions": []
        }
    ],
    "roles": {
        "realm": [
            {
                "name": "user",
                "description": "Regular user role"
            },
            {
                "name": "admin",
                "description": "Administrator role"
            }
        ]
    },
    "clientScopes": [
        {
            "name": "openid",
            "protocol": "openid-connect",
            "attributes": {}
        },
        {
            "name": "profile",
            "protocol": "openid-connect",
            "attributes": {}
        },
        {
            "name": "email",
            "protocol": "openid-connect",
            "attributes": {}
        }
    ],
    "clients": [
        {
            "clientId": "keycloak",
            "enabled": true,
            "redirectUris": ["http://localhost:4000/callback"],
            "webOrigins": ["http://localhost:4000"],
            "defaultRoles": ["admin","user"],
            "secret": "your_client_secret"
        },{
            "clientId": "springboot_client",
            "enabled": true,
            "redirectUris": ["http://localhost:8000/*"],
            "webOrigins": ["http://localhost:8000"],
            "defaultRoles": ["admin","user"],
            "secret": "your_client_secret",
            "defaultClientScopes": ["openid", "profile", "email"],
            "authorizationServicesEnabled": true,
            "authorizationSetting":{
                
            }
        }
    ]
}