{
    "realm": "backend",
    "enabled": true,
    "users": [
        {
            "username": "admin",
            "enabled": true,
            "credentials": [
                {
                    "type": "password",
                    "value": "admin_password",
                    "temporary": false
                }
            ]
        }
    ],
    "roles": {
        "realm": [
            {
                "name": "user",
                "description": "Regular user role"
            },
            {
                "name": "admin",
                "description": "Administrator role"
            }
        ]
    },
    "clientScopes": [
        {
            "name": "email",
            "protocol": "openid-connect",
            "attributes": {}
        }
    ],
    "clients": [
        {
            "clientId": "keycloak",
            "enabled": true,
            "redirectUris": ["http://localhost:4000/callback"],
            "webOrigins": ["http://localhost:4000"],
            "defaultRoles": ["admin"],
            "secret": "your_client_secret"
        }
    ]
}